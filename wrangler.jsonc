{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tempo-ai-text-call",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  }
}
